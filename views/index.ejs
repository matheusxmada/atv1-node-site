<!-- Index do site -->
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>RALLYHUB</title>

    <link rel="stylesheet" href="/css/style.css" />
  </head>

  <body>
    <!-- INcluindo a navbar -->
    <%- include("partials/navbar") %>

    <!-- Incluindo o header -->
    <%- include("partials/header") %>

    <main>
      <section class="cars-section" id="carros">
        <div class="section-title">

          <h2 class="super-title-cards">Carros mais icônicos do Rally</h2>

          <div class="title-line"></div>
        </div>

        <div class="cars-grid">

          <!-- Audi Quattro -->
          <a href="/AudiQuattro" class="car-card audi-card">
            <div class="car-number">01</div>

            <h3>Audi Quattro S1</h3>

            <p>
              Um dos carros responsáveis por revolucionar o Rally com a
              utilização da tração integral.
            </p>

            <span> CONHECER → </span>
          </a>

          <!-- Lancia Delta -->
          <a href="/LanciaDelta" class="car-card delta-card">
            <div class="car-number">02</div>

            <h3>Lancia Delta S4</h3>

            <p>
              Uma das máquinas mais vitoriosas da história do WRC.
            </p>

            <span> CONHECER → </span>
          </a>

          <!-- Subaru Impreza -->
          <a href="/SubaruImpreza" class="car-card subaru-card">
            <div class="car-number">03</div>

            <h3>Subaru Impreza 22B STi</h3>

            <p>
              Ícone das pistas e símbolo da Subaru no cenário mundial do Rally.
            </p>

            <span> CONHECER → </span>
          </a>

          <!-- Lancia Stratos -->
          <a href="/LanciaStratos" class="car-card stratos-card">
            <div class="car-number">04</div>

            <h3>Lancia Stratos HF</h3>

            <p>
              Um lendário carro desenvolvido especialmente para dominar as
              competições de Rally.
            </p>

            <span> CONHECER → </span>
          </a>

          <!-- Peugeot 205 -->
          <a href="/Peugeot205" class="car-card peugeot-card">
            <div class="car-number">05</div>

            <h3>Peugeot 205 T16</h3>

            <p>
              Uma das máquinas mais marcantes e extremas da lendária era do
              Grupo B.
            </p>

            <span> CONHECER → </span>
          </a>

        </div>
      </section>
    </main>

    <!-- Incluindo o footer -->
    <%- include("partials/footer") %>
  </body>
</html>