<!-- Página Sobre Nós -->
<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Sobre Nós | RALLYHUB</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <!-- Incluindo a navbar -->
    <%- include("partials/navbar") %>


        <main class="about-main">

            <!-- Hero -->

            <section class="about-hero">

                <div class="about-hero-content">

                    <p class="hero-subtitle">
                        RALLYHUB / SOBRE NÓS
                    </p>

                    <h1>
                        NOSSA<br>
                        <span>HISTÓRIA</span>
                    </h1>

                    <p class="hero-text">
                        O RALLYHUB é um espaço dedicado à história,
                        aos carros e às grandes conquistas do mundo
                        do Rally.
                    </p>

                    <a href="#sobre" class="hero-button">
                        CONHEÇA O RALLYHUB
                    </a>

                </div>

            </section>


            <!-- Sobre o projeto -->

            <section id="sobre" class="about-section">

                <div class="about-container">

                    <div class="about-text">

                        <p class="about-subtitle">
                            SOBRE O PROJETO
                        </p>

                        <h2>
                            A PAIXÃO PELO<br>
                            <span>RALLY</span>
                        </h2>

                        <div class="title-line"></div>

                        <p>
                            O RALLYHUB foi criado com o objetivo de treinar meus conhecimentos
                            sobre Node.js e EJS, além de reunir
                            informações sobre alguns dos carros mais
                            marcantes da história do Rally.
                            <br>
                            Comecei a gostar de Rally a partir de jogos incríveis como o clássico Gran Turismo 4 de
                            Playstation 2,
                            Dirt Rally, EA Sports WRC, Asseto Corsa, entre outros.
                        </p>

                        <p>
                            Minha proposta é apresentar de forma simples
                            e organizada a história,
                            características e as principais
                            competições das quais participaram.
                        </p>

                        <p>
                            O projeto busca aproximar os fãs do
                            automobilismo da história por trás de alguns
                            dos carros que ajudaram a transformar o Rally
                            em uma das modalidades mais conhecidas e insanas do
                            automobilismo mundial.
                        </p>

                    </div>


                    <div class="about-image">

                        <img src="/images/wallpaper-2.jpg" alt="Carro de Rally">

                    </div>

                </div>

            </section>


            <!-- Objetivo -->

            <section class="about-objective">

                <div class="about-objective-content">

                    <div class="about-objective-text">

                        <p class="about-subtitle">
                            NOSSO OBJETIVO
                        </p>

                        <h2>
                            HISTÓRIA.<br>
                            VELOCIDADE.<br>
                            <span>RALLY.</span>
                        </h2>

                        <p>
                            Preservar e apresentar a história dos grandes
                            carros do Rally, mostrando como tecnologia,
                            engenharia e competição se combinaram para
                            criar algumas das máquinas mais memoráveis
                            do automobilismo numa das modalidades mais
                            extremas já vistas.
                        </p>

                        <a href="/cars" class="hero-button">
                            EXPLORAR CARROS
                        </a>

                    </div>


                    <div class="about-objective-image">

                        <img src="/images/wallpaper-5.jpg" alt="Carro de Rally">

                    </div>

                </div>

            </section>

        </main>


        <!-- Incluindo o footer -->
        <%- include("partials/footer") %>

</body>

</html>