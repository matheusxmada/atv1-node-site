<!-- Página Outros Tópicos -->
 
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Outros Tópicos | RALLYHUB</title>
    

    <link rel="stylesheet" href="/css/style.css" />
    <!-- <link rel="stylesheet" href="/css/style-other.css"> -->
  </head>

  <body>
    <!-- Incluindo a navbar -->

    <%- include("partials/navbar") %>

    <main class="other-main">
      <!-- Hero -->

      <section class="other-hero">
        <div class="other-hero-content">
          <p class="hero-subtitle">RALLYHUB / OUTROS TÓPICOS</p>

          <h1>
            EXPLORE<br />
            <span>O RALLY</span>
          </h1>

          <p class="hero-text">
            Descubra diferentes aspectos da história, das categorias e das
            competições que ajudaram a construir o mundo do Rally.
          </p>
        </div>
      </section>

      <!-- Tópicos -->

      <section class="other-topics">
        <div class="other-topics-header">
          <p class="about-subtitle">OUTROS TÓPICOS</p>

          <h2>
            ALÉM DOS<br />
            <span>CARROS</span>
          </h2>

          <div class="title-line"></div>

          <p>
            O universo do Rally vai muito além das máquinas, propriamente dito. Conheça alguns dos
            elementos que fazem parte da história e da identidade da modalidade.
          </p>
        </div>

        <div class="other-cards">
          <!-- ========================================================================== Card 01 -->

          <a href="#" class="other-card">
            <div class="other-card-image">
              <img src="/images/wallpaper-10.jpeg" alt="História do Rally" />
            </div>

            <div class="other-card-overlay"></div>

            <div class="other-card-content">

              <h3>
                HISTÓRIA<br />
                DO <strong>RALLY</strong>
              </h3>

              <p>
                Conheça a evolução do Rally, desde suas origens dos anos 1910 até a era
                moderna.
              </p>

              <span class="other-card-link"> EXPLORAR → </span>
            </div>
          </a>

          <!-- ========================================================================== Card 02 -->

          <a href="#" class="other-card">
            <div class="other-card-image">
              <img src="/images/wallpaper-7.jpg" alt="Categorias do Rally" />
            </div>

            <div class="other-card-overlay"></div>

            <div class="other-card-content">

              <h3>
                GRUPOS E<br />
                <strong>CATEGORIAS</strong>
              </h3>

              <p>
                Entenda as principais categorias que marcaram diferentes eras do
                Rally, desde o R1 até o tão aclamado WRC.
              </p>

              <span class="other-card-link"> EXPLORAR → </span>
            </div>
          </a>

          <!-- ========================================================================== Card 03 -->

          <a href="#" class="other-card">
            <div class="other-card-image">
              <img src="/images/wallpaper-8.jpg" alt="Competições de Rally" />
            </div>

            <div class="other-card-overlay"></div>

            <div class="other-card-content">

              <h3>
                GRANDES<br />
                <strong>RALLYS</strong>
              </h3>

              <p>
                Descubra algumas das competições mais importantes do
                automobilismo.
              </p>

              <span class="other-card-link"> EXPLORAR → </span>
            </div>
          </a>
        </div>
      </section>
    </main>

    <!-- Incluindo o footer -->

    <%- include("partials/footer") %>
  </body>
</html>
