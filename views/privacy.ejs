<!-- Página de Política de Privacidade -->

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Política de Privacidade | RALLYHUB</title>

    <link rel="stylesheet" href="/css/style.css" />
  </head>

  <body>
    <!-- Incluindo a navbar -->
    <%- include("partials/navbar") %>

    <main class="privacy-main">
      <section class="privacy-section">
        <div class="privacy-container">
          <p class="privacy-subtitle">RALLYHUB / PRIVACIDADE</p>

          <h1>
            POLÍTICA DE<br />
            <span>PRIVACIDADE.</span>
          </h1>

          <div class="title-line"></div>

          <p class="privacy-text">
            O RALLYHUB valoriza a privacidade de seus visitantes. Este site foi
            desenvolvido com finalidade acadêmica e informativa, não tendo como
            objetivo coletar, armazenar ou compartilhar dados pessoais dos
            usuários. As informações apresentadas no site são destinadas
            exclusivamente à consulta sobre Rally, seus carros, competições e
            sua história. Ao utilizar o RALLYHUB, o visitante concorda com esta
            política e reconhece que o projeto poderá ser atualizado ou
            modificado conforme suas necessidades acadêmicas e técnicas. Todas
            as fontes, tanto de informações quanto de imagens, foram recolhidas
            em sites de domínio público.
          </p>
        </div>
      </section>
    </main>

    <!-- Incluindo o footer -->
    <%- include("partials/footer") %>
  </body>
</html>
